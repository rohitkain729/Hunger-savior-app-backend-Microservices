spring:
datasource:
  driver-class-name: com.mysql.cj.jdbc.Driver
  username: dbuser
  url: jdbc:mysql://localhost:3306/restaurants
  password: dbpass
application:
  name: restaurant-service
jpa:
  database-platform: org.hibernate.dialect.MySQL5InnoDBDialect
  properties:
    hibernate:
      format_sql: 'true'
  hibernate:
    ddl-auto: update
  show-sql: 'true'
